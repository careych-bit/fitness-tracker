rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function validWorkout(data) {
      return data.keys().hasAll([
        'User_ID',
        'Workout_name',
        'Date',
        'Start_Time',
        'Duration',
        'Completion',
        'Notes'
      ]) &&
      data.User_ID is string &&
      data.Workout_name is string &&
      data.Date is string &&
      data.Start_Time is string &&
      data.Duration is number &&
      data.Duration > 0 &&
      data.Completion is bool &&
      data.Notes is string;
    }

    function validGoal(data) {
  return data.keys().hasAll([
    'User_ID',
    'Metric',
    'Target',
    'Unit',
    'Start_Date',
    'Target_Date',
    'Created_At',
    'Updated_At'
  ]) &&
  data.keys().hasOnly([
    'User_ID',
    'Metric',
    'Target',
    'Unit',
    'Start_Date',
    'Target_Date',
    'Created_At',
    'Updated_At'
  ]) &&
  data.User_ID is string &&
  data.Metric == 'workouts' &&
  data.Target is number &&
  data.Target > 0 &&
  data.Target % 1 == 0 &&
  data.Unit == 'workouts' &&
  data.Start_Date is string &&
  data.Start_Date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
  data.Target_Date is string &&
  data.Target_Date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
  data.Start_Date <= data.Target_Date &&
  data.Created_At is timestamp &&
  data.Updated_At is timestamp;
}

    match /workouts/{workoutId} {
  allow create: if
    request.auth != null &&
    request.auth.uid == request.resource.data.User_ID &&
    validWorkout(request.resource.data) &&
    request.resource.data.Completion == false;

  allow read: if
    request.auth != null &&
    request.auth.uid == resource.data.User_ID;

  allow delete: if
    request.auth != null &&
    request.auth.uid == resource.data.User_ID &&
    resource.data.Completion != true;

  allow update: if
    request.auth != null &&
    request.auth.uid == resource.data.User_ID &&
    resource.data.Completion != true &&
    request.resource.data.User_ID == resource.data.User_ID &&
    validWorkout(request.resource.data) &&
    (
      request.resource.data.Completion == false ||
      (
        request.resource.data.Completion == true &&
        request.resource.data.Completed_At is timestamp &&
        request.resource.data.Completed_At == request.time
      )
    );
}

    match /goals/{goalId} {
  allow create: if
    request.auth != null &&
    request.auth.uid == request.resource.data.User_ID &&
    validGoal(request.resource.data) &&
    request.resource.data.Created_At == request.time &&
    request.resource.data.Updated_At == request.time;

  allow read, delete: if
    request.auth != null &&
    request.auth.uid == resource.data.User_ID;

  allow update: if
    request.auth != null &&
    request.auth.uid == resource.data.User_ID &&
    request.resource.data.User_ID == resource.data.User_ID &&
    request.resource.data.Created_At == resource.data.Created_At &&
    request.resource.data.Updated_At == request.time &&
    validGoal(request.resource.data);
}

    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }
  }
}